// Mono-space font required
{
"porcupine": {
	//        0              1                2             3                   4
	"unit": ["turretlaser", "turretmissile", "turretriot", "turretheavylaser", "turrettorp",
	//        5              6                7             8                 9
		"turretaalaser", "staticcon", "turretheavy", "staticshield", "turretemp",
	//       10             11               12            13                14
		"turretantiheavy", "staticarty", "turretaafar", "turretaaheavy", "turretgauss",
	//       15		        16
		"staticantinuke", "staticheavyradar"
	],
	// Actual number of defences per cluster bounded by income
	"land":  [0, 0, 1, 3, 5, 1, 2, 14, 1, 9, 5, 6, 2, 3, 5, 0, 8, 9, 14, 1, 3, 6, 16, 12, 11, 13],
	"water": [4, 1, 6, 4, 4, 3, 5, 9, 16],
	// Preventive defences: towers a cluster gets outside porc mode, the first <count> of "land"/"water".
	// chance = prevent x prevent_map x prevent_mex; count = its whole part, plus 1 with the odds of its fraction
	// (0.5 = a 50% chance of 1 tower, 1.5 = 1 tower and a 50% chance of a 2nd). Each cluster rolls the first time
	// it is defended, again every prevent_reroll[0] s (the new count replaces the old), and on a sighting: an enemy
	// in LOS that can hit ground (air included) within mex LOS of our mex there, at most once per prevent_reroll[1] s
	// since the last roll; a sighting's roll can only raise the count. A roll never cancels a queued or built tower.
	// Missing keys: prevent 1, prevent_reroll [180, 30], curves x1 (missing or []), prevent_air off.
	"prevent": 0.5,
	"prevent_reroll": [180, 30],  // [seconds between rolls, min seconds since the last roll for a sighting to force one]
	// Multiplier curves [[<x>, <multiplier>], ...], linear between points, flat beyond the ends
	"prevent_map": [[32, 1.5], [128, 0.7]],  // x = map area in 512-elmo squares (16x16 = 256) / players on our team
	"prevent_mex": [[0.2, 0.6], [0.5, 1.2]],  // x = ally-team finished mexes / all metal spots
	"prevent_air": "turretmissile",  // first tower after a sighting of a flying enemy; "" = off
	// Geothermal vents as clusters: a vent that no mex defence point covers gets its own point (in its nearest
	// cluster's list, sharing that cluster's preventive roll). Our geo there is defended like a mex: on finishing
	// (build_chain energygeo "porc") and on a sighting (prevent_reroll[1]); towers for a vent stay at the vent.
	// Vent points never count as the cluster's defence (mex escort) or its front positions. Missing = false
	"geo": true,
	"amount": {  // income bound factor
		"offset": [-0.15, 0.4],
		// Amount factor: 4x4 ~ 1.85, 20x20 ~ 1.45
		"factor": [1.55, 1.30],
		"map": [4, 20]
	},


	// Base defence and time to build it, in seconds
	"base": [[0, 10], [1, 300], [0, 310], [1, 400], [6, 450], [0, 500], [16, 600], [5, 660], [1, 990], [5, 1160], [1, 1380], [2, 1680], [13, 1800], [15, 1850]],

	"superweapon": {
		"unit":   ["raveparty", "staticnuke", "staticheavyarty", "zenith", "mahlazer", "staticantinuke"],  // FIXME: last aren't superweapon
		"weight": [ 0.10,         0.20,        0.20,              0.10,     0.10,    0.10],

		"condition": [16, 20000]  // [<Minimum income>, <maximum seconds to build>]
	},

	// Fallback defence
	"default": "turretmissile"
},

// Actions on building finished event
"build_chain": {
	// WARNING: Avoid recursion
	// <category>: factory, nano, store, pylon, energy, defence, bunker, big_gun, radar, sonar, mex, repair
	"energy": {
		// <UnitDef>: {<elements>}
		"energysingu": {
			// Available elements:
			// "energy": [max energy income, <"mex"|true>]
			// "pylon": <boolean>
			// "porc": <boolean>
			// "terra": <boolean>
			// "hub": [
			//     // chain1
			//     [{<unit1>, <category>, <offset>, <condition>}, {<unit2>, <category>, <offset>, <condition>}, ...],
			//     // chain2
			//     [{...}, {...}, ...],
			//     ...
			// ]
			// <unit>: UnitDef
			// <offset>:
			//     1) [x, z] in South facing, elmos
			//     2) {<direction>: <delta>} - left, right, front, back
			// <condition>: air, no_air, maybe

			// Build pylon in direction of nearby mex cluster
//			"pylon": true,

			// Build chain of units
