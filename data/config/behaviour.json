// Mono-space font required
{
"quota": {
	"scout": 1,  // max scout units out of raiders
	"scout_per_mex": 1.0,
	"scout_max": 12,  // cap on "scout" + bonus ("scout" itself is never cut); 0 = no cap
	"scout_spot": {
		"enemy": 2.5,       // weight for closeness to the enemy (default 1.0)
		"stale": 1.0,       // weight for time since the spot was last seen (default 1.0)
		"travel": 0.2,      // penalty for distance from the scout (default 0.5)
		"home_ratio": 0.5,  // skip spots nearer our base than this x their distance to the enemy (default 0.5)
		"stale_time": 90,   // seconds until a seen spot counts as fully stale (default 90)
		"claim_time": 20,   // seconds a picked spot stays reserved for that scout (default 20)
		"static_range_mult": 1.0  // scales enemy defence ranges when judging if a spot is defended (default 1.0)
	},  
        "target_dist_mod": {"comm": 0.5},
	// Second multiplier on that bonus: this curve at the map size, divided by all players. Points are
	// [<map side in map units, e.g. 8 for 8x8; non-square maps use sqrt(w*h)>, <multiplier>], flat beyond the ends
	"scout_map_size": [[8, 1.0], [20, 4.0]],

	"raid": [9.0, 20.0],  // [<min>, <avg>] power of raider squad
	"attack": 10.0,  // min power of attack group

	"raid_flee_share": 0.33,
        "attack_flee_share": 0.33,  // attack group flees (to the nearest stronger attack group, else a haven, else base) when units standing in danger hold at least this share of its current strength; 0 = any unit, 1 = whole group

	"attack_spot_threat": 0.33,  // ranged units in attack, defend and anti-air groups fire from a spot within 90% of their range of the target: score = this x (threat there / unit strength + 0.5 per other unit's spot within 80 elmos) + walking distance / range; 0 = nearest spot, higher = more cover-seeking
"attack_group_radius": [2.0, 800],  // [<x the group's highest weapon/LOS range>, <min elmos>]: attack group units farther than this from their leader are stragglers: while the group fights they walk to the leader instead of straight to a firing spot
         "attack_keep_threat": 1.34,  // attack group's current target stays acceptable up to this x the usual threat allowance (at its spot, and on the approach line when in range; not on its route), so it isn't dropped and re-picked over small swings; not inside the base defence radius; 1 (or less) = off
	"attack_path_dynamic_cost": {"target": true, "reinforce": true, "front": true, "flee": true, "cornered": true},  // attack group routes, per kind (target = route to a target, reinforce = to a group it joins, front = to the front, flee = escape, cornered = to a quieter spot): true = a cell's threat cost is threat x (1 + threat / the threat the group tolerates there, i.e. its strength x thr_mod base bonus / distance curve / near-base scale, as the escape uses), i.e. about half the usual for light threat, the same at the escape's danger line, steeper above; false = the flat 2 x threat; true/false alone sets all
	"attack_flee_path_max_weight": 3.0,  // flee and cornered routes with attack_path_dynamic_cost on: the threat weight (1 + threat / tolerated threat) is at most this (the flat weight is 2); >= 1
	"attack_path_ignore_threat": 0.25,  // attack group routes to a target, the front or a group to reinforce count threat at or below this x the group's current strength as none (no detour around it); 0 = off; max 0.5 / the highest value of thr_mod.distance.attack (0.25 with the attack curve below, which peaks at 2.0), also x thr_mod.base_bonus if that is below 1; higher acts as that max


	"attack_merge": {  // how attack groups join (the smaller walks to the bigger), absorb (an army pulls in small groups) and reinforce (a small group walks to the nearest stronger group)
	"speed_ratio": 1.5,  // leaders' speeds within this factor of each other, else the groups never merge or reinforce each other
	"distance": 800,  // leaders within this many elmos may join or absorb (>= 1)
	"travel_sec": 10,  // ...and at most this many seconds of straight travel apart at the walking group's slowest speed (1 to 60; keeps arrivals inside the 60 s regroup limit, after which far-away units are dropped as stuck)
	"join_interval": [8, 16],  // [<group under quota.attack>, <army>]: check for a group to join every this many updates (~1 s each)
	"absorb_interval": 12,  // an army absorbs small groups every this many updates
	"support_radius": 400,  // on the line to the bigger group, within this many elmos of its leader both groups' strength counts against threat
	"reinforce_range": 400,  // a reinforcing group's route only has to get this close to the stronger group's leader (merging finishes it); never more than 80% of what the group can merge from (distance, or travel_sec at its slowest speed)
	"reinforce_fails": 4,  // empty reinforce routes in a row (one per ~2 s decision) before giving up
	"reinforce_retry": 15  // seconds to act as a small attack group after giving up, before looking for a group again
         },
	"thr_mod": {
		"base_bonus": 2.0,
		"scale_min": 0.25,  // attack groups count threat at spots nearer our base than where they picked their target as less, by (spot-to-base / group-to-base)^2, but never below this; 0.25 = at most 4x; 1 = off
		"raid":   [0.85, 0.9],  // [<min>, <max>]; 1.0 = the distance curve below is the whole modifier
		"scout":  [1.00, 1.00],
		"attack": [0.66, 0.9],
		"defence": [0.66, 0.9],  // [<min>, <max>] group size calculation of defence task (not distance based)
		// [<fraction of map diagonal from base>, <multiplier>] points; tasks: scout, raid, defend, attack, aa, ah, bomber
		"distance": {
			"raid":   [[0.4, 1.00], [0.9, 1.75]],
			"scout":  [[0.4, 1.5], [0.9, 1.6]],
			"attack": [[0.4, 1.00], [0.9, 2.0]],
			"defend": [[0.4, 1.00], [0.9, 2.0]]
		},

		"mobile": 1.00,  // initial modifier for power of attack group based on mobile enemy threat
		"static": 1.00,  // initial modifier for power of attack group based on static enemy threat
		"comm": 0.75
	},
	"aa_threat": 80.0,  // anti-air threat threshold, air factories will stop production when AA threat exceedsx
	"slack_mod": {
		"all": 1.0,  // threat map 64-elmos slack multiplier for all units
		"static": 1.0,  // additional 64-elmo-cells for static units
		"speed": [0.36, 5.2]  // [<64elmo_cells_speed_mod>, <max_64elmo_cells>]
	}
},

// If unit's health drops below specified percent it will retreat
"retreat": {
	"builder": [0.70, 1.0],  // [<default>, <UnitDef modifier>] for all builders
	"fighter": [0.45, 1.0],  // [<default>, <UnitDef modifier>] for all not-builder units
	"shield": [0.25, 0.275],  // [<empty>, <full>] shield power
        "repair_safe_static": true,  // same as repair_safe, for static units with prio_repair
	"wait_timeout": 120,  // seconds a retreated unit waits at haven with no repairer before returning to duty, 0 = no limit
	"repair_safe": true,  // false = builders skip priority repair (heavy/prio_repair) where threat exceeds their strength in enemy-held area, like regular jobs
	"repair_pull": [600, 0.4],  // [<range>, <max share of builders>]: nearest busy builder in range drops its work to repair a damaged heavy/prio_repair unit, range 0 = disabled
        "repair_leash": [300, 5]  // [<distance>, <cooldown sec>]: cancel a started priority repair if the unit drives this far beyond build range, then no new priority repair for it during cooldown, distance 0 = disabled
},

"defence": {
	"infl_rad": 8,  // influenece cell radius for defendAlly map
	"base_rad": [1000.0, 2000.0],  // defend if enemy within clamp(distance(lane_pos, base_pos), 1000, 2000) radius
	"comm_rad": [1000.0, 500.0]  // 0 distance from base ~ 1000, base_rad ~ 500.0
},

// Builder that follows a strong attack group: patrols behind it (auto repair/reclaim like fight) while the group
// holds or advances, plain moves while it falls back towards base, threat-aware path when it lags behind
"escort": {
	"min_power": 40.0,  // min attack power of a group to get and keep an escort builder (compare quota.attack), 0 = disabled
	"share": 0.15,  // max share of builders on escort duty (rounded down: 4 builders * 0.2 = 0 escorts)
	"behind": 300.0,  // distance behind the group leader, towards base
	"follow": 300.0,  // if further than this from its spot, builder catches up along a threat-aware path
	"range": 600.0,  // only builders within this distance of any group member are picked
	"comm": false,  // allow commander as escort
	"take_from": "normal"  // highest job priority a builder can be taken off for escort: "idle" (idle builders only), "low", "normal" or "high" (urgent jobs never)
},

// Mobile anti-air squads (main role anti_air)
"antiair": {
	"leash": 800.0,  // only chase aircraft within this distance of home: one of our attack/defend group leaders or the base; aircraft already in weapon range are always engaged; -1 = no leash (chase the nearest aircraft anywhere)
	"own_ground": true,  // also counts as near home: the spot the squad would shoot from is covered by our buildings or static defences (defence.infl_rad), or our other armed units beat the enemy (not counting the plane) under the aircraft
	"fire_spot": 0.9,  // check enemy threat where the squad would stand to shoot (this fraction of its shortest weapon range short of the aircraft, towards the squad) instead of under the aircraft; -1 = old check under the aircraft
	"flee_margin": 300.0,  // flee when an armed mobile ground enemy we see now (or a moving low radar blip) is within its weapon range + this of a squad unit: to the nearest attack/defend group, defended mex cluster or base further from it; -1 = off (flee only once hit)
	"flee_cover": true  // no early flee while our other armed units' influence at the squad leader beats the enemy's (it stands with an army or defences)
},

"artillery": {
	"ally_threat": 10.0,  // only walk to a firing spot with at least this much allied power within ally_radius: our and allied mobile armed units, not counting artillery (main role) or aircraft, so artillery can't escort itself. Power is each unit's power including its pwr_mod (thr_mod is ignored). A building already in range is shot only while the spot still has this much cover, otherwise the unit rejoins the group; -1 = any spot, always shoot (old behaviour)
	"ally_radius": 500.0,  // see ally_threat
	"max_path_threat": 1.0,  // the path to a firing spot may not cross enemy threat (threat map, summed and fading with distance) above this x the unit's own power (including pwr_mod); if no such path exists it joins a group instead; -1 = no limit (threat is only avoided where cheap)
	"no_scout": true,  // nothing to shoot or walk to: stay put while the spot is threat-free and (ally_threat) covered, otherwise move to safety: behind the nearest attack/defend group, else a defended mex cluster, else the base. false = old behaviour: walk the scout route to enemy mexes, or fight-move to a random spot
	"follow_dist": 300.0,  // when moving to safety near a group, stand this far behind its leader on the side towards our base
	"artillery_flee_margin": 400.0  // checked every update: flee when an armed mobile enemy currently in radar or LOS (aircraft, paralysed and unfinished units excluded; unidentified radar blips only while moving) is within its weapon range + this, unless (ally_threat) our cover is at the artillery's spot. It runs to the nearest safety spot (behind a group, defended mex cluster, base) that is further from the enemy, else the one furthest from it, and stops fleeing once the enemy is out of reach or cover arrives; -1 = off. Default for all artillery; a unit type can override it with its own artillery_flee_margin in its "behaviour" entry
},


// Bodyguard for early unarmed builders: one unit per guard slot (needs CircuitAI PR #3)
"guard": {
	"roles": ["raider", "riot"],  // main roles that may take a builder's guard slot; a custom role ("bullshit_raider") matches only itself, a base role ("raider") also matches roles bound to it; [] = nobody guards
	"max_workers": 30,  // an unarmed builder gets a guard slot if, once it is finished, the worker count (commander included) is below this; 0 = off
	"safe": [1.0, 0.01],  // [ally, enemy]: guard leaves while its builder stands where allied influence (guards excluded, same units as quota.attack) >= ally and enemy influence <= enemy; ally <= 0 = never safe. The guard also leaves while the builder retreats
	"safe_time": 3.0,  // seconds the builder must stay safe before its guard leaves (stops a passing army from sending the guard away)
	"pull_range": 800.0,  // an empty slot whose builder needs a guard pulls the nearest eligible unit within this distance (not retreating or guarding, can reach the builder); 0 = only units asking for a new task fill it
        "threat_cooldown": 10.0,  // a guard standing in enemy threat is cancelled and its builder gets no guard for this many seconds; -1 = never cancel on threat
	"threat_ratio": 1.25,  // ... but only if enemy threat at the guard > this * the guard's own threat; lower values cancel on lighter threat, 0 = any threat
        "max_share": 0.3,  // max share of each role's units guarding at once, per acting main role (0.3 = 30% of raiders and 30% of riots), rounded up so 1 unit of a role may guard; 1.0 = no limit, 0 = none
        "guarded_max_share": 0.3, // as above, but for combat units instead of constructors.
        "damage_exit": true  // a guard that takes damage is released at once, and its builder gets no guard for threat_cooldown seconds (10 if threat_cooldown is -1). A guard released by damage or threat can't guard any builder for that long
},

