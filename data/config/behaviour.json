// Mono-space font required
{
"quota": {
	"scout": 1,  // max scout units out of raiders
	"scout_per_mex": 1.0,
	"scout_max": 12,  // cap on "scout" + bonus ("scout" itself is never cut); 0 = no cap
	"scout_spot": {
		"enemy": 2.5,       // weight for closeness to the enemy (default 1.0)
		"stale": 1.0,       // weight for time since the spot was last seen (default 1.0)
		"travel": 0.2,      // penalty for distance from the scout (default 0.5)
		"home_ratio": 0.5,  // skip spots nearer our base than this x their distance to the enemy (default 0.5)
		"stale_time": 90,   // seconds until a seen spot counts as fully stale (default 90)
		"claim_time": 20,   // seconds a picked spot stays reserved for that scout (default 20)
		"static_range_mult": 1.0  // scales enemy defence ranges when judging if a spot is defended (default 1.0)
	},  
	// Raider production floor: while we have fewer raider units (main role "raider" or a role bound to it, e.g.
	// "cloaked_raider"; alive and not scouting, plus queued in factories) than "raider" + bonus, a factory that can build a raider
	// builds one (picked by its factory.json tier weights). The bonus is the scout formula (with raider_map_size),
	// counting enemy mexes a starting raid group (quota.raid[0] power) can reach. All three missing = no floor
	"raider": 1,  // min raider units
	"raider_per_mex": 1.0,  // 0 = no bonus (default 0)
	"raider_max": 12,  // cap on "raider" + bonus ("raider" itself is never cut); 0 = no cap
	"raider_map_size": [[8, 1.0], [20, 4.0]],  // the raider bonus's map size curve, as scout_map_size; missing = use scout_map_size
	// Raid groups with no enemies known roam between scored spots (same scoring as scout_spot, own claims; the
	// group's leader holds the claim) instead of the old mex list; contested clusters still come first. Missing = old roaming
	"raider_spot": {
		"enemy": 2.5,       // weight for closeness to the enemy (default 1.0)
		"stale": 1.0,       // weight for time since the spot was last seen (default 1.0)
		"travel": 0.5,      // penalty for distance from the group's leader (default 0.5)
		"home_ratio": 0.5,  // skip spots nearer our base than this x their distance to the enemy (default 0.5)
		"stale_time": 90,   // seconds until a seen spot counts as fully stale (default 90)
		"claim_time": 20,   // seconds a picked spot stays reserved for that group (default 20)
		"static_range_mult": 1.0  // scales enemy defence ranges when judging if a spot is defended (default 1.0)
	},
        "target_dist_mod": {"comm": 0.5},
	// Second multiplier on that bonus: this curve at the map size, divided by all players. Points are
	// [<map side in map units, e.g. 8 for 8x8; non-square maps use sqrt(w*h)>, <multiplier>], flat beyond the ends
	"scout_map_size": [[8, 1.0], [20, 4.0]],

	"raid": [9.0, 20.0],  // [<min>, <avg>] power of raider squad
	"attack": 10.0,  // min power of attack group

	"raid_flee_share": 0.33,
        "attack_flee_share": 0.33,  // attack group flees (to the nearest stronger attack group, else a haven, else base) when units standing in danger hold at least this share of its current strength; 0 = any unit, 1 = whole group

	"attack_spot_threat": 0.33,  // ranged units in attack, defend and anti-air groups fire from a spot within 90% of their range of the target: score = this x (threat there / unit strength + 0.5 per other unit's spot within 80 elmos) + walking distance / range; 0 = nearest spot, higher = more cover-seeking
"attack_group_radius": [2.0, 800],  // [<x the group's highest weapon/LOS range>, <min elmos>]: attack group units farther than this from their leader are stragglers: while the group fights they walk to the leader instead of straight to a firing spot
	"attack_static_cells": {"on": true, "rings": [0.9, 0.7], "angles": 16, "sectors": 8, "threat_weight": 1.0, "score_slack": 0.5, "cell_aim_height": 16, "parked_sec": 5},  // attack groups route to a static target beyond LOS range by its safe firing cells: points on rings at these x the group's fire range (power-weighted median weapon range; the second ring only if the first yields nothing), reachable, below the usual threat allowance and with line of sight to the target (aimed cell_aim_height elmos up); best point per sector (the sectors facing us first), score = threat_weight x threat / group strength + distance / fire range, cells more than score_slack worse than the best are left out. The route then ends in a wedge of a cell's sector at about LOS range. Undefended targets, melee groups, and targets with no line of sight anywhere are routed to as before; targets with no cell below the allowance are skipped for 6, 12, 24 s (beyond LOS range only). Parked mobiles: a mobile target seen standing on one spot in LOS for parked_sec seconds (0 = off), no faster than 1.25 x the group's slowest unit and not a nanoframe, gets cells too (the sectors facing us only), around that spot, until it leaves it. Optional "siege_bonus": <x> (default 1 = off): a mobile type no faster than 1.25 x the group's slowest unit and with at least 1.2 x our fire range against ground (artillery) ranks x times closer, parked or not, while in radar or LOS or out of both for under parked_sec. Only in addition to the usual check at the target's own spot; on: false = as before
         "attack_keep_threat": 1.34,  // attack group's current target stays acceptable up to this x the usual threat allowance (at its spot, and on the approach line when in range; not on its route), so it isn't dropped and re-picked over small swings; not inside the base defence radius; 1 (or less) = off
	"attack_own_ground_time": 270,  // seconds from game start during which attack groups only go for targets on our ground: within defence.infl_rad of our buildings, land constructors or static defences (influence map; enemy influence, our armed mobile units and unarmed aircraft are ignored); a target already within range is always fair game; with none they go to the front line as usual; 0 = off
	"contested": {"wall": 3.0, "bonus": 2.0, "age": 60, "range": 300},  // wall: threat at a mex cluster's centre up to this doesn't block the builders' cluster walk (above it the walk stops there, so safe mexes behind it are never found; each spot still needs threat <= 1 to be built; a Glaive is about 2.2); min and default 1 = the old rule. Clusters with more threat than wall are contested: attack and raid groups that can take the threat there (at their usual allowance) treat enemies within the cluster radius + range elmos as bonus x closer (attack target ranking, unless an enemy is already within range; raid route goals); raids with no enemies known go to the nearest such cluster before roaming; a mark lasts age seconds unless seen again; bonus 1 = off
	"attack_path_dynamic_cost": {"target": true, "reinforce": true, "front": true, "flee": true, "cornered": true},  // attack group routes, per kind (target = route to a target, reinforce = to a group it joins, front = to the front, flee = escape, cornered = to a quieter spot): true = a cell's threat cost is threat x (1 + threat / the threat the group tolerates there, i.e. its strength x thr_mod base bonus / distance curve / near-base scale, as the escape uses), i.e. about half the usual for light threat, the same at the escape's danger line, steeper above; false = the flat 2 x threat; true/false alone sets all
	"attack_flee_path_max_weight": 3.0,  // flee and cornered routes with attack_path_dynamic_cost on: the threat weight (1 + threat / tolerated threat) is at most this (the flat weight is 2); >= 1
	"attack_path_ignore_threat": 0.25,  // attack group routes to a target, the front or a group to reinforce count threat at or below this x the group's current strength as none (no detour around it); 0 = off; max 0.5 / the highest value of thr_mod.distance.attack (0.25 with the attack curve below, which peaks at 2.0), also x thr_mod.base_bonus if that is below 1; higher acts as that max


	"attack_merge": {  // how attack groups join (the smaller walks to the bigger), absorb (an army pulls in small groups) and reinforce (a small group walks to the nearest stronger group)
	"speed_ratio": 1.5,  // leaders' speeds within this factor of each other, else the groups never merge or reinforce each other
	"distance": 800,  // leaders within this many elmos may join or absorb (>= 1)
	"travel_sec": 10,  // ...and at most this many seconds of straight travel apart at the walking group's slowest speed (1 to 60; keeps arrivals inside the 60 s regroup limit, after which far-away units are dropped as stuck)
	"join_interval": [8, 16],  // [<group under quota.attack>, <army>]: check for a group to join every this many updates (~1 s each)
	"absorb_interval": 12,  // an army absorbs small groups every this many updates
	"support_radius": 400,  // on the line to the bigger group, within this many elmos of its leader both groups' strength counts against threat
	"reinforce_range": 400,  // a reinforcing group's route only has to get this close to the stronger group's leader (merging finishes it); never more than 80% of what the group can merge from (distance, or travel_sec at its slowest speed)
	"reinforce_fails": 4,  // empty reinforce routes in a row (one per ~2 s decision) before giving up
	"reinforce_retry": 15,  // seconds to act as a small attack group after giving up, before looking for a group again
	"base_gather": false,  // false: attack-bound units never gather at base; they reinforce the rally host or the nearest compatible group, else start a group. true: the first army gathers at base
	// Rally: when a recently seen enemy blob (mobile, armed enemies within 800 elmos of each other, threat summed) near our attack groups has more threat than match x the largest group's raw strength,
	// that group (the host) walks to meet its significant joiners and every compatible attack group and new unit reinforces it, until it reaches (1 + margin) x match x the blob or the blob is lost
	"rally": {
		"match": 1.0,  // rally while host strength < match x blob threat; 0 = off
		"margin": 0.25,  // end once host strength >= match x blob x (1 + margin)
		"range": 3000,  // a blob starts a rally only within this many elmos of an attack group's leader; it keeps one going up to 1.5x this
		"seen_sec": 20  // enemies count only if seen this recently; a rally ends when no blob has been found for this long
	}
         },
	"thr_mod": {
		"base_bonus": 2.0,
		"scale_min": 0.25,  // attack groups count threat at spots nearer our base than where they picked their target as less, by (spot-to-base / group-to-base)^2, but never below this; 0.25 = at most 4x; 1 = off
		"raid":   [0.85, 0.9],  // [<min>, <max>]; 1.0 = the distance curve below is the whole modifier
		"scout":  [1.00, 1.00],
		"attack": [0.66, 0.9],
		"defence": [0.66, 0.9],  // [<min>, <max>] group size calculation of defence task (not distance based)
		// [<fraction of map diagonal from base>, <multiplier>] points; tasks: scout, raid, defend, attack, aa, ah, bomber
		"distance": {
			"raid":   [[0.4, 1.00], [0.9, 1.75]],
			"scout":  [[0.4, 1.5], [0.9, 1.6]],
			"attack": [[0.4, 1.00], [0.9, 2.0]],
			"defend": [[0.4, 1.00], [0.9, 2.0]]
		},

		"mobile": 1.00,  // initial modifier for power of attack group based on mobile enemy threat
		"static": 1.00,  // initial modifier for power of attack group based on static enemy threat
		"comm": 0.75
	},
	"pwr_mod": {
		"comm": 1.1  // power multiplier for every commander, as a unit's own "pwr_mod": our view of its strength (commander flee cover, group power); threat stays thr_mod.comm
	},
	"aa_threat": 80.0,  // anti-air threat threshold, air factories will stop production when AA threat exceedsx
	"slack_mod": {
		"all": 1.0,  // threat map 64-elmos slack multiplier for all units
		"static": 1.0,  // additional 64-elmo-cells for static units
		"speed": [0.36, 5.2]  // [<64elmo_cells_speed_mod>, <max_64elmo_cells>]
	}
},

// If unit's health drops below specified percent it will retreat
"retreat": {
	"builder": [0.70, 1.0],  // [<default>, <UnitDef modifier>] for all builders
	"fighter": [0.45, 1.0],  // [<default>, <UnitDef modifier>] for all not-builder units
	"shield": [0.25, 0.275],  // [<empty>, <full>] shield power
        "repair_safe_static": true,  // same as repair_safe, for static units with prio_repair
	"wait_timeout": 120,  // seconds a retreated unit waits at haven with no repairer before returning to duty, 0 = no limit
	"repair_safe": true,  // true = builders skip priority repair (heavy/prio_repair) where threat exceeds their strength in enemy-held area, like regular jobs, and leave a mobile unit's repair (priority or retreat) once it leads them into such an area
	"repair_pull": [600, 0.4],  // [<range>, <max share of builders>]: nearest busy builder in range drops its work to repair a damaged heavy/prio_repair unit, range 0 = disabled
        "repair_leash": [300, 5],  // [<distance>, <cooldown sec>]: cancel a started priority or retreat (HIGH) repair if the unit, no longer retreating, drives this far beyond build range, then no new priority repair for it during cooldown, distance 0 = disabled
	"repair_flee": [0.5],  // [<speed share>]: a mobile unit (not retreating) out of a builder's reach and moving away from it faster than this share of its own max speed is not picked for repair, 0 = disabled
	"repair_chase": [3, 64],  // [<sec>, <elmos>]: a builder out of reach of a moving unit it repairs (repair job, or the engine's own repair while escorting or patrolling) that hasn't closed the gap by this many elmos in this many seconds drops it, then repair_leash cooldown (escorts and patrols move instead of patrol meanwhile), sec 0 = disabled
	// [<margin>, <ally_threat>, <ally_radius>]: ground builders other than commanders flee as the commander does (commander.json hide): from an armed mobile enemy seen now within its weapon range + margin, unless they and our armed units and static defences within ally_radius, minus the enemies' threat, reach ally_threat (-1 = flee regardless). They run to the nearest defended mex cluster, factory or base (not to attack groups) and work again once nothing seen in the last 5 s is within range + margin + max(25%, 50), or cover reaches ally_threat over 1.25x the enemies' threat. Jobs keep out of that line unless so covered; armed builds (turrets) and repairs of armed units or turrets only keep out of range + margin, and for 5 s after any of them flees, all their jobs also keep out of the enemy it ran from, at the wider line, even once it is unseen. Cornered, they build a static defence behind them that can hit the enemy and outranges it (or help such a one started on their side) and stay on it until it is done, they are hurt or metal stalls; one nobody has started is dropped 30 s after its last builder leaves. Flying builders never flee; margin -1 = off. A unit type can override the margin with its own builder_flee_margin in its "behaviour" entry
	"builder_flee": [-1, 0.0, 500.0],
	"flee_log": false  // true = one infolog line per flee start and end ("FLEE start/end"), commanders and other builders, with the threat and cover; for test games
},

"defence": {
	"infl_rad": 8,  // influenece cell radius for defendAlly map
	"base_rad": [1000.0, 2000.0],  // defend if enemy within clamp(distance(lane_pos, base_pos), 1000, 2000) radius
	"comm_rad": [1000.0, 500.0]  // 0 distance from base ~ 1000, base_rad ~ 500.0
},

// Builder that follows a strong attack group: patrols behind it (auto repair/reclaim like fight) while the group
// holds or advances, plain moves while it falls back towards base, threat-aware path when it lags behind
"escort": {
	"min_power": 40.0,  // min attack power of a group to get and keep an escort builder (compare quota.attack), 0 = disabled
	"share": 0.15,  // max share of builders on escort duty (rounded down: 4 builders * 0.2 = 0 escorts)
	"behind": 300.0,  // distance behind the group leader, towards base
	"follow": 300.0,  // if further than this from its spot, builder catches up along a threat-aware path
	"range": 600.0,  // only builders within this distance of any group member are picked
	"comm": false,  // allow commander as escort
	"take_from": "normal"  // highest job priority a builder can be taken off for escort: "idle" (idle builders only), "low", "normal" or "high" (urgent jobs never)
},

// Mobile anti-air squads (main role anti_air)
"antiair": {
	"leash": 800.0,  // only chase aircraft within this distance of home: one of our attack/defend group leaders or the base; aircraft already in weapon range are always engaged; -1 = no leash (chase the nearest aircraft anywhere)
	"own_ground": true,  // also counts as near home: the spot the squad would shoot from is covered by our buildings or static defences (defence.infl_rad), or our other armed units beat the enemy (not counting the plane) under the aircraft
	"fire_spot": 0.9,  // check enemy threat where the squad would stand to shoot (this fraction of its shortest weapon range short of the aircraft, towards the squad) instead of under the aircraft; -1 = old check under the aircraft
	"flee_margin": 300.0,  // flee when an armed mobile ground enemy we see now (or a moving low radar blip) is within its weapon range + this of a squad unit: to the nearest attack/defend group, defended mex cluster or base further from it; -1 = off (flee only once hit)
	"flee_ally_threat": 10.0,  // no early flee while our and allied mobile armed units (not AA, not aircraft) and static defences that can hit ground (not superweapons), within flee_ally_radius of the squad leader, minus the threat of the enemies that set off the flee, add up to at least this power (pwr_mod included, scaled by sqrt(health %); unfinished units don't count); -1 = flee regardless of escorts; missing = 10 when flee_margin is set
	"flee_ally_radius": 500.0  // see flee_ally_threat
},

// Concede a lost 1v1: checked every 10 s from "time" on, only when each side is a single team. Resign when our
// ally team holds fewer than "mex" x the map's metal spots AND the known enemy mobile threat (every enemy mobile
// unit seen, commander and builders included) is more than "threat" x ours (our finished mobile units, same scale).
// Says "<CircuitAI> I am defeated." in public chat, then leaves the game (/aikill), which Zero-K counts as a resign. Missing block or time < 0 = never resign
"resign": {
	"time": 480,  // seconds of game time
	"mex": 0.1,
	"threat": 4.0
},

// Self-destruct own ground units stuck under water deeper than their move type can walk in (knocked or pushed off a
// shore, dropped there, or the seabed terraformed under them). Checked every second; hovers, ships, subs, amphibious
// units and aircraft never count, nor does a unit held above the water by a transport. The order is sent once and
// never cancelled. Missing block or time < 0 = off
"drowned": {
	"time": 10.0  // seconds stuck before the self-destruct order
},

// Anti-heavy squads (main role anti_heavy: Lance, Ultimatum, Scorpion, Merlin, ...)
"antiheavy": {
	"path_threat": 1.0,  // routes (to a heavy, to safety, home) may not cross enemy threat above this x the squad's allowance: its strength (power x sqrt(health %)) x the task's power mod x base_bonus / thr_mod.distance at the strictest end, as anti-air's routes. The route to a heavy ends at its stand-off point (on our side, the first walkable spot from just outside the heavy's own threat ring, never nearer than the squad's LOS, whose threat is under the cap; a heavy with no such spot within a few cells isn't walked to), so the cap meets only its escorts; from there the squad attacks it. Never below the threat where the squad stands; the way home tries once more through any threat; -1 = no cap and the old routes straight to the heavy (threat is only avoided where cheap). Aircraft never get the cap
	"flee_margin": 200.0,  // checked every update: flee when an armed mobile enemy we see now (mobile bombs and gunships included, not planes or AA-only units; unidentified radar blips while they move and sit low) is within its ground weapon range + this of a squad unit. The heavies and commanders the squad hunts don't count. Shoot and scoot: after a shot with a long reload (5 s or more), each unit on its own steps straight away from the target to just outside its ground range + this (it stays put if it is already out of reach) and attacks again once its weapon is ready, while the rest of the squad fights on; such a unit doesn't count for regrouping. It runs towards the nearest attack/defend group, defended mex cluster or base further from the enemy, and stops where it is once nothing is within range + margin x 1.25 (at least +50). A heavy is only picked as a target if the spots the squad would attack it from and walk to are outside these flee zones, or escorts cover them (flee_ally_threat), so an escorted heavy waits for the army. Mines and aircraft never flee; -1 = off. A unit type can override it with its own antiheavy_flee_margin in its "behaviour" entry
	"flee_ally_threat": 10.0,  // no flee while our and allied mobile armed units (not anti-heavy, not aircraft) and static defences that can hit ground, within flee_ally_radius of the squad leader, minus the threat of the enemies that set off the flee, add up to at least this power (pwr_mod included, scaled by sqrt(health %)); -1 = flee regardless of escorts; missing = 10 when flee_margin is set
	"flee_ally_radius": 500.0  // see flee_ally_threat
	// Per unit type, in its "behaviour" entry: "antiheavy_max_group": <n> = at most n units of that type in one
	// anti-heavy squad (squads only grow by merging; a merge that would go over is skipped); missing or 0 = no limit
},

"artillery": {
	"ally_threat": 10.0,  // only walk to a firing spot with at least this much allied power within ally_radius: our and allied mobile units with a ground or water weapon, not counting artillery (main role, so artillery can't escort itself), planes (gunships do count), anti-air only units or mobile bombs. Power is each unit's power including its pwr_mod (thr_mod is ignored). A building already in range is shot only while the spot still has this much cover, otherwise the unit rejoins the group; -1 = any spot, always shoot (old behaviour)
	"ally_radius": 500.0,  // see ally_threat
	"max_path_threat": 1.0,  // the path to a firing spot may not cross enemy threat (threat map, summed and fading with distance) above this x the unit's own power (including pwr_mod); if no such path exists it joins a group instead; -1 = no limit (threat is only avoided where cheap)
	"no_scout": true,  // nothing to shoot or walk to: stay put while the spot is threat-free and (ally_threat) covered, otherwise move to safety: behind the nearest attack/defend group, else a defended mex cluster, else the base. false = old behaviour: walk the scout route to enemy mexes, or fight-move to a random spot
	"follow_dist": 300.0,  // when moving to safety near a group, stand this far behind its leader on the side towards our base
	"artillery_flee_margin": 400.0  // checked every update: flee when an armed mobile enemy currently in radar or LOS (mobile bombs and gunships included; planes, units that can only shoot aircraft, paralysed and unfinished units excluded; unidentified radar blips only while moving) is within its ground weapon range (a bomb's blast radius) + this, unless (ally_threat) our cover at the artillery's spot (static defences that can hit ground count here too, not superweapons), minus the threat of the enemies that set off the flee, still reaches ally_threat. It runs to the nearest safety spot (behind a group, defended mex cluster, base) that is further from the enemy, else the one furthest from it, and stops fleeing once the enemy is out of reach or cover arrives. Firing spots inside such an enemy's reach are skipped unless that cover is there; -1 = off. Default for all artillery; a unit type can override it with its own artillery_flee_margin in its "behaviour" entry
},

// Line formation: attack groups of land or sea units walk their path as a line across it, with more rows only where
// it has to narrow, while they aren't engaging, fleeing or cornered. Where no line of 2 fits (terrain, buildings) the
// units follow the path as before until 2 fit again for 3 s. The line waits for units that fall behind; the usual
// regroup still gathers one that falls far behind. At the end of its walk the group stands in line. Missing block or
// "enable": false = groups walk as before
"formation": {
	"enable": true,
	"min_units": 3,  // land or sea units needed to form a line (off again below 2); aircraft, support units and no_formation units don't take a slot
	"spacing": [96.0, 4, 0.35],  // [<elmos>, <units>, <exponent>]: neighbours this far apart up to this many units, closer beyond: x (units / n)^exponent (6 units 83, 10 units 70, 25 units 51); never closer than half their footprints + gap. Squeezed down to 0.7 of it before a second row is added
	"gap": 16.0,  // elmos between footprints, and clearance at the line's ends; rows are their widest footprint + 3 gaps apart
	"width_range": 1.5,  // the line is at most this x the group's power-weighted median weapon range wide (at least 3 spacings, at most 900 elmos), less where terrain, buildings or more enemy threat than on the path leave less room in the next 3 s of walking; rows shift sideways to fit, and no slot lies past a spot that isn't free, seen from the path
	"lead_sec": 1.5,  // the line walks at its slowest unit's speed (support units included), slows in proportion as the unit furthest behind its slot (or a busy leader) falls behind, and stops when it is this many seconds behind; not while an enemy is in LOS of the group (or was in the last 5 s), when it walks on regardless. A unit out of its slot for 12 s straggles (catches up at full speed, the line doesn't wait for it); while the line walks, one that hasn't moved 64 elmos in 30 s is released to find a new task. Units with the "jump" attribute jump along the path whenever their jump is ready, as before
	"face_range": 2.0,  // once the line stands at the end of its walk, it turns to face the enemy threat read around it (8 ways, at half and all of this x the group's fire range), if the threat has a clear side, else the way it came; it turns about its centre (its front row short of more threat than at the centre), only where it fits that way (walkable, 2 columns wide), and again only for a clear threat more than 45° off for 2 s, and keeps facing while new paths end within 256 elmos of the same spot; 0 = off (the line stands across its path's last stretch)
	"row_order": ["riot", "assault", "heavy", "raider", "skirmish", "anti_heavy", "anti_air", "artillery"]  // main roles from the front row back, when there is more than one row (a custom role goes where the role it acts as goes); unlisted roles last
	// Per unit type, in its "behaviour" entry: "formation_row": <n> = its place in row_order instead (0 = front);
	// "attribute": ["no_formation"] = never takes a slot (follows the path as before)
},


// Bodyguard for early unarmed builders: one unit per guard slot (needs CircuitAI PR #3)
"guard": {
	"roles": ["raider", "riot"],  // main roles that may take a builder's guard slot; a custom role ("bullshit_raider") matches only itself, a base role ("raider") also matches roles bound to it; [] = nobody guards
	"max_workers": 30,  // an unarmed builder gets a guard slot if, once it is finished, the worker count (commander included) is below this; 0 = off
	"safe": [1.0, 0.01],  // [ally, enemy]: guard leaves while its builder stands where allied influence (guards excluded, same units as quota.attack) >= ally and enemy influence <= enemy; ally <= 0 = never safe. The guard also leaves while the builder retreats
	"safe_time": 3.0,  // seconds the builder must stay safe before its guard leaves (stops a passing army from sending the guard away)
	"pull_range": 800.0,  // an empty slot whose builder needs a guard pulls the nearest eligible unit within this distance (not retreating, guarding, scouting or in an attack squad of 2+, can reach the builder); 0 = only units asking for a new task fill it
	"interpose": [120.0, 600.0],  // [<distance>, <range>]: while a mobile armed ground enemy in LOS/radar (or unknown radar dot; turrets are ignored) is within <range> of the vip, the guard stands <distance> from the vip towards the nearest one (at most halfway) instead of following it with the engine Guard order; distance 0 = engine Guard only
        "threat_cooldown": 10.0,  // a guard standing in enemy threat is cancelled and its builder gets no guard for this many seconds; -1 = never cancel on threat
	"threat_ratio": 1.25,  // ... but only if enemy threat at the guard > this * the guard's own threat; lower values cancel on lighter threat, 0 = any threat
        "max_share": 0.3,  // max share of each role's units guarding at once, per acting main role (0.3 = 30% of raiders and 30% of riots), rounded up so 1 unit of a role may guard; 1.0 = no limit, 0 = none
        "guarded_max_share": 0.3, // as above, but for combat units instead of constructors.
        "damage_exit": true  // a guard that takes damage is released at once, and its builder gets no guard for threat_cooldown seconds (10 if threat_cooldown is -1). A guard released by damage or threat can't guard any builder for that long
},

