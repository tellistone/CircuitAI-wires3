// Mono-space font required
{
"quota": {
	"scout": 1,  // max scout units out of raiders
	"raid": [7.0, 42.0],  // [<min>, <avg>] power of raider squad
	"raid_target_roles": ["builder", "commander"],  // enemy roles raid groups attack first (plus types with the "raid_target" attribute); [] = attribute only
	"raid_flee_share": 0.5,  // raid group flees when units standing in danger hold at least this share of its current strength; 0 = any unit, 1 = whole group
	"attack": 20.0,  // min power of attack group
	"thr_mod": {
		"attack": [0.45, 0.45],  // [<min>, <max>] enemy threat modifier for target selection of attack task
		"raid": [0.45, 0.45],  // same for raid task (raider groups): target choice, escape and path threat; missing = use "attack"
		"scout": [0.45, 0.45],  // same for scout task; missing = use "attack"
		"base_bonus": 2.0,  // raid and defence groups inside the base defence radius accept up to this x threat at the base centre, falling to 1 at the radius edge; 1 = off; multiplies with "distance"
		// Per task: multiply its thr_mod by distance from our base as a fraction of the map diagonal (higher = more cautious).
		// [<fraction>, <multiplier>] points, linear between, flat beyond the ends; tasks: scout, raid, defend, attack, aa, ah, bomber; missing task = 1
		"distance": {
			"raid":  [[0.1, 0.5], [0.9, 2.0]],
			"scout": [[0.1, 0.5], [0.9, 2.0]]
		},
		"defence": [0.80, 0.80],  // [<min>, <max>] enemy threat modifier for group size calculation of defence task
		"mobile": 1.075,  // initial modifier for power of attack group based on mobile enemy threat
		"static": 4.25,  // initial modifier for power of attack group based on static enemy threat
		"comm": 0.75
	},
	"aa_threat": 80.0,  // anti-air threat threshold, air factories will stop production when AA threat exceeds
	"slack_mod": {
		"all": 0.5,  // threat map 64-elmos slack multiplier for all units
		"static": 1.5,  // additional 64-elmo-cells for static units
		"speed": [0.75, 4.0]  // [<64elmo_cells_speed_mod>, <max_64elmo_cells>]
	}
},

// If unit's health drops below specified percent it will retreat
"retreat": {
	"builder": [0.70, 1.0],  // [<default>, <UnitDef modifier>] for all builders
	"fighter": [0.45, 1.0],  // [<default>, <UnitDef modifier>] for all not-builder units
	"shield": [0.25, 0.275],  // [<empty>, <full>] shield power
	"wait_timeout": 60,  // seconds a retreated unit waits at haven with no repairer before returning to duty, 0 = no limit
	"repair_safe": false,  // true = builders skip priority repair of mobile units (heavy/prio_repair) where threat exceeds their strength in enemy-held area, like regular jobs
	"repair_safe_static": false,  // same as repair_safe, for static units with prio_repair
	"repair_pull": [1500, 0.34],  // [<range>, <max share of builders>]: nearest busy builder in range drops its work to repair a damaged heavy/prio_repair unit, range 0 = disabled
	"repair_leash": [300, 20]  // [<distance>, <cooldown sec>]: cancel a started priority repair if the unit drives this far beyond build range, then no new priority repair for it during cooldown, distance 0 = disabled
},

// Builder that follows a strong attack group: patrols behind it (auto repair/reclaim like fight) while the group
// holds or advances, plain moves while it falls back towards base, threat-aware path when it lags behind
"escort": {
	"min_power": 60.0,  // min attack power of a group to get and keep an escort builder (compare quota.attack), 0 = disabled
	"share": 0.2,  // max share of builders on escort duty (rounded down: 4 builders * 0.2 = 0 escorts)
	"behind": 150.0,  // distance behind the group leader, towards base
	"follow": 600.0,  // if further than this from its spot, builder catches up along a threat-aware path
	"range": 600.0,  // only builders within this distance of any group member are picked
	"comm": false,  // allow commander as escort
	"take_from": "high"  // highest job priority a builder can be taken off for escort: "idle" (idle builders only), "low", "normal" or "high" (urgent jobs never)
},

// Artillery (main role artillery): each unit works alone, shooting known enemy buildings
"artillery": {
	"ally_threat": 10.0,  // only walk to a firing spot where allied influence (same units as guard.safe, the unit itself excluded) is at least this; buildings already in range are always shot; -1 = any spot (old behaviour)
	"max_path_threat": 1.0,  // the path to a firing spot may not cross enemy threat above this x the unit's own power; if no such path exists it joins a group instead; -1 = no limit (threat is only avoided where cheap)
	"no_scout": true,  // nothing to shoot or walk to: join the nearest attack/defend group (else a defended mex cluster, else the base) instead of walking the scout route to enemy mexes or fight-moving to a random spot
	"follow_dist": 300.0  // when joining a group, stand this far behind its leader on the side towards our base
},

"guard": {
	// units with "attribute": ["guarded"] (e.g. artillery) also get a guard slot that follows all the rules below
	"roles": ["raider", "riot"],  // main roles that may take a builder's guard slot; a custom role ("bullshit_raider") matches only itself, a base role ("raider") also matches roles bound to it; [] = nobody guards
	"max_workers": 3,  // an unarmed builder gets a guard slot if, once it is finished, the worker count (commander included) is below this; 0 = off
	"max_share": 1.0,  // max share of each role's units guarding at once, per acting main role (0.3 = 30% of raiders and 30% of riots), rounded up so 1 unit of a role may guard; 1.0 = no limit, 0 = none
	"guarded_max_share": -1.0,  // same as max_share, but a separate pool for the slots of "guarded" units, so builder slots can't use it up; -1 = same value as max_share
	"safe": [20.0, 0.01],  // [ally, enemy]: the guard leaves while its builder stands where allied influence >= ally (here 20.0) and enemy influence <= enemy (here 0.01). The guard's own contribution at that spot isn't counted. Influence is in the same strength units as quota.attack. Both the builder's position and its current job's location (e.g. the mex it is walking to) must be safe. ally <= 0 = never safe. The guard also leaves while the builder retreats
	"safe_time": 5.0,  // seconds the builder must stay safe before its guard leaves (stops a passing army from sending the guard away)
	"pull_range": 800.0,  // max distance from the builder for any guard (assigned or pulled); an empty slot whose builder needs a guard also pulls the nearest eligible unit within it (idle, raid or defend task; never scouts, attack squads, retreating or guarding units; must reach the builder); 0 = only units asking for a new task fill it
	"threat_cooldown": 10.0,  // a guard standing in enemy threat is cancelled and its builder gets no guard for this many seconds; -1 = never cancel on threat
	"threat_ratio": 1.0,  // ... but only if enemy threat at the guard > this * the guard's own threat; lower values cancel on lighter threat, 0 = any threat
	"damage_exit": true,  // a guard that takes damage is released at once, and its builder gets no guard for threat_cooldown seconds (10 if threat_cooldown is -1). A guard released by damage or threat can't guard any builder for that long
	"debug": false  // true = write guard events and a status line per slot every 10 s to infolog.txt (lines start with "GUARD")
},

"defence": {
	"infl_rad": 4,  // influenece cell radius for defendAlly map
	"base_rad": [1000.0, 2000.0],  // defend if enemy within clamp(distance(lane_pos, base_pos), 1000, 2000) radius
	"comm_rad": [1000.0, 500.0]  // 0 distance from base ~ 1000, base_rad ~ 500.0
},


"behaviour": {
	// factorycloak
	"cloakcon": {
		// "role": [<main>, <enemy>, <enemy>, ...]
		// <main> is the role to make desicions of when to build it and what task to assign
		// <enemy> is to decide how to counter enemy unit, if missing then equals to <main>
		// Roles: builder, scout, raider, riot, assault, skirmish, artillery, anti_air, anti_sub, anti_heavy, bomber, support, mine, transport, air, sub, static, heavy, super, commander
		// Auto-assigned roles: builder, air, static, super, commander
		"role": ["builder", "mine"]

		// Attributes - optinal states
		// "melee" - always move close to target, disregard attack range
		// "boost" - boost speed on retreat
		// "no_jump" - disable jump on retreat
		// "no_strafe" - disable gunship's strafe
		// "stockpile" - load weapon before any task, auto-assigned
		// "siege" - mostly use fight command instead of move
		// "ret_hold" - hold fire on retreat
		// "ret_fight" - fight on retreat
		// "jump" - enable jump on regular move
		// "dg_cost" - DGun by metal cost instead of by threat
		// "anti_stat" - only static targets
		// "no_dgun" - do not use DGun
		// "prio_repair" - when damaged above retreat threshold, builders rush to repair it (like "heavy" main role); on statics: below 90% health; commanders always have it
		// "guarded" - gets a guard slot like an early builder (see "guard" block); never guards others; flying units and static defences excluded
		// "raid_target" - raid groups attack this enemy type first, nearest one wins (in addition to quota.raid_target_roles)
//		"attribute": ["boost", "no_strafe"],

		// Fire state (open by default)
		// "hold" - hold fire
		// "return" - return fire
		// "open" - fire at will
