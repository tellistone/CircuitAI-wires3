// Mono-space font required
{
"economy": {
	// Plain list of energy UnitDef and its limit. AI sorts list by efficiency (inverse)
	// which is = cost * sizeX * sizeZ / make^2
	// With current ZK stats:
	//   energysingu = 15.486420
	//   energyfusion = 65.306122
	//   energygeo = 80.000000
	//   energywind = 874.999939
	//   energysolar = 1750.000000
	// When e-stalling AI will build bottom-most energy that didn't reach its limit.
	// On normal AI will select top-most energy that it can build under 40 seconds.
	// Geothermal (energygeo) is not part of that order: it is checked first and built on a free vent whenever it is
	// under its limit and can be built in time (see "geo" below); no free vent or its limit never blocks other energy.
	"energy": {
		// If land area >= 40% of the map then "land" config used, "water" otherwise
		"land": {
			// "<energy_def>": [<lower limit>, <upper limit>]
			// limit = random(<lower limit>..<upper limit>)
			"energysingu": [6],
			"energygeo": [3, 6],  // also capped by free vents; skipped (doesn't block cheaper energy) when none is free
			"energyfusion": [6, 10],
			"energysolar": [10, 20]
		},
		"water": {
			"energysingu": [1],
			"energygeo": [2, 4],
			"energyfusion": [4],
			"energywind": [20]
		},
		// income factor for energy, time is in seconds
		// [[<start_factor>, <start_time>], [<end_factor>, <end_time>]]
		"factor": [[0.15, 1], [7.0, 3600]],

		// Geothermal (energygeo): built exactly on the nearest free vent our builder can reach
		"geo": {
			"threat": 1.0,  // skip vents (and don't morph geos) where enemy surface threat is above this
			"morph": [30.0, 900]  // [<min avg metal income>, <earliest second>]: morph one finished energygeo at a time into energyheavygeo; income -1 = never
		},

		"link_inc": 16.0,  // minimum metal-income for energy linking
		"pylon": ["energypylon", "energysolar", "energywind"]
	},

	// Scales metal income
	// ecoFactor = teamSize*eps_step+(1-eps_step)
	"eps_step": 0.2,

	// Mobile buildpower to metal income ratio
	"buildpower": 1.25,

	// Also build constructors while their metal value is below <ratio> of the mobile army's metal value.
	// Off before <since> seconds of game time; ratio 0 disables. Commanders don't count as constructors.
	"buildpower_army": {"ratio": 0.10, "since": 600},

	// Also build constructors while their metal value is below <ratio> of the metal left in
	// reclaimable features we can see (wrecks, rocks) that the factory's constructor can reach with
	// no enemy threat on them. Off before <since> seconds; ratio 0 disables.
	"buildpower_reclaim": {"ratio": 0.10, "since": 300},

	// Constructor reclaim jobs.
	// value_exp: features rank by distance / (metal left)^value_exp, lower first; 0 = nearest only, 1 = metal per distance.
	// helper_sec: a job takes another constructor while its metal is above <helper_sec> seconds of the build power on it.
	// untaken_sec: a wreck job nobody has taken expires after this many seconds, so stale far jobs don't hold the
	//   untaken-job cap (max(1, constructors / 2)). A job with constructors on it never times out.
	// store_at: while any constructor reclaims and metal is above this share of storage, queue a storage at HIGH; 0 disables.
	// New reclaim jobs stop above 80% metal storage; running ones carry on.
	// travel: how far a constructor looks for new reclaim, in seconds of travel at its speed, by the feature's metal left.
	//   Linear from <sec>[0] at 1 metal to <sec>[1] at <metal> and above, never below <floor>.
	//   <starved_sec> replaces <sec> while metal pull x 0.8 is above income. An idle constructor with no other job
	//   still searches the whole map.
	"reclaim": {"value_exp": 0.5, "helper_sec": 20.0, "untaken_sec": 30, "store_at": 0.7,
	            "travel": {"metal": 2000, "sec": [1, 30], "starved_sec": [1, 60], "floor": 5}},

	// Seconds before a non-combat constructor may build a mex at an undefended cluster without an escort,
	// by map size: [[<map size>, <seconds>], ...], linear between points and clamped at the ends.
	// Map size is sqrt(width * height) in map units, so 8x8 = 8 and 16x16 = 16.
	"mex_escort": [[8, 300], [16, 0]],

	// Multiplier on the open mex job cap, (build power / mex cost * 8 + 2) * <mex_jobs>
	"mex_jobs": 1.5,

	// Mex cluster choice leans towards the front (the lane point between our base and the enemy).
	// The <clusters> nearest safe clusters with open spots are scored by
	//   distance to their nearest open spot x (1 - <bias> x progress) x (1 - <started> if we already have a mex queued or built there),
	// progress = how far the cluster centre is along base -> lane (0 at base, 1 at the lane, clamped to [-1, 1]).
	// The lowest-scored cluster wins and its nearest open spot is built. <started> keeps clusters finishing one at a time.
	// bias 0 and clusters 1 = old behaviour (nearest spot in the nearest cluster with an open spot).
	// comm_bias: the bias when a commander's search queues the job (missing = bias). Any constructor can still take the job.
	"mex_front": {"bias": 0.15, "comm_bias": 0.34, "clusters": 3, "started": 0.3},

	// How constructors choose between open jobs: travel cost / <weight> of the job's priority, lowest wins (NOW always wins).
	// travel: seconds of travel per priority; a job beyond its cap is taken only when no job is within its cap. 0 = no cap.
	// switch: a constructor walking to a job takes a job of the same kind that is nearer than <switch> x its current
	//   distance (0.5 = less than half as far); 0 disables.
	"builder_jobs": {
		"weight": {"low": 1, "normal": 2, "high": 4},
		"travel": {"low": 10, "normal": 20, "high": 30},
		"switch": 0.5
	},

	// Metal excess to income ratio, -1 to disable
	"excess": -1.0,

	// Mobile constructor to static constructor metal pull ratio
	// [[<value>, <start_mex_percent>], [<value>, <end_mex_percent>]]
	"ms_pull": [[2.0, 0.0], [0.45, 0.20], [0.99, 0.90]],

	// Max percent of mexes circuit team allowed to take.
	// If its <1.0 then expansion obeys ms_pull rule, if >=1.0 then ms_pull doesn't affect expansion (mex, pylon, energy).
	// [<cap_percent>, <is_ally_cap>]
	"mex_max": [2.0, false],  // 200%

	// Construction order delay in seconds, -1 to disable
	// [[<start_delay>, <start_time>], [<end_delay>, <end_time>]]
	"build_delay": [[-1.0, 0], [-1.0, 0]],

	// New factory switch interval, in seconds (each new factory resets timer, switch event is also based on eco + caretakers)
	// switch = random(<min_interval>..<max_interval>)
	"switch": [800, 900],

	"terra": "terraunit",
	"airpad": "staticrearm",

	// Unknown UnitDef replacer
	"default": "turretmissile"
}
}
