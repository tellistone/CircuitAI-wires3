// Mono-space font required
{
"economy": {
	// Plain list of energy UnitDef and its limit. AI sorts list by efficiency (inverse)
	// which is = cost * sizeX * sizeZ / make^2
	// With current ZK stats:
	//   energysingu = 15.486420
	//   energyfusion = 65.306122
	//   energygeo = 80.000000
	//   energywind = 874.999939
	//   energysolar = 1750.000000
	// When e-stalling AI will build bottom-most energy that didn't reach its limit.
	// On normal AI will select top-most energy that it can build under 40 seconds.
	// Geothermal (energygeo) is not part of that order: it is checked first and built on a free vent whenever it is
	// under its limit and can be built in time (see "geo" below); no free vent or its limit never blocks other energy.
	"energy": {
		// If land area >= 40% of the map then "land" config used, "water" otherwise
		"land": {
			// "<energy_def>": [<lower limit>, <upper limit>]
			// limit = random(<lower limit>..<upper limit>)
			"energysingu": [6],
			"energygeo": [3, 6],  // also capped by free vents; skipped (doesn't block cheaper energy) when none is free
			"energyfusion": [6, 10],
			"energysolar": [10, 20]
		},
		"water": {
			"energysingu": [1],
			"energygeo": [2, 4],
			"energyfusion": [4],
			"energywind": [20]
		},
		// income factor for energy, time is in seconds
		// [[<start_factor>, <start_time>], [<end_factor>, <end_time>]]
		"factor": [[0.15, 1], [7.0, 3600]],

		// Geothermal (energygeo): built exactly on the nearest free vent our builder can reach
		"geo": {
			"threat": 1.0,  // skip vents (and don't morph geos) where enemy surface threat is above this
			// Job and ZK build priority for an energygeo job while energy isn't short: "low", "normal" or "high" (default).
			// "high" ranks it with mex jobs for builders and gives it resources before normal jobs. It drops to normal
			// while metal stalls, so mexes come first then. Energy short: high whatever this says
			"priority": "high",
			"morph": [30.0, 900]  // [<min avg metal income>, <earliest second>]: morph one finished energygeo at a time into energyheavygeo; income -1 = never
		},

		// Built behind the base, as far from the enemy as allowed, instead of at the nearest mex spot.
		// "<energy_def>": {"min": <min distance from base>, "max": <max distance from base>,
		//                  "link": <prefer sites touching our (or an ally's) energy grid, so the energy can overdrive mexes; default true>}
		// "Behind" = within 90 deg of straight back from the lane (the fixed start->front direction mex_front uses).
		// The site is the nearest open one (block_map.json's spacing: fusion and singu keep their blast radius off
		// factories and each other) to a grid building behind the base when link is on, else to the point straight back
		// at max distance. Reserved when queued; searched again every 10 s. No safe site: cheaper energy is built instead
		"rear": {
			"energyfusion": {"min": 0, "max": 1200},
			"energysingu": {"min": 800, "max": 1800}
		},

		// Grid consumers (customParams.neededlink: Big Bertha, Cerberus, Desolator, Lucifer, strider hub, superweapons)
		// work only on a grid with that much energy. Ours (from the first nanoframe) the game reports unpowered for 2 reads in a row
		// (10 s apart) get energypylons, one at a time, from their own grid towards the nearest other grid with
		// margin x neededlink, until they are powered. Superweapons are only drawn while some grid has that much, and
		// porc consumers are only built where such a grid is in reach of max_pylons
		"grid_link": {
			"max_pylons": 6,  // most pylons per structure until it's powered; 0 = off
			"margin": 1.1  // grid capacity needed = margin x neededlink
		},

		// Cheap energy placement: energy jobs (and the mex build_chain's energy) of these defs go, within max_dist elmos
		// of the builder (of the mex for the chain; a third of that while short of energy), in this order:
		//   1. beside the nearest finished mex of ours on no grid with energy (the game's grids; energy of the ally
		//      team beside it, being built too, also counts; a mex the game hasn't put on a grid yet is on the one
		//      it overlaps)
		//   2. into the nearest open gap of the planned grid: a planned link between two finished mex clusters
		//      (CEnergyGrid's spanning tree), or between the mexes of one; from a gap end, one piece per gap at a time
		//   3. beside a mex of the grid with the least energy per mex: the one with the least energy beside it (not a
		//      base_only piece on land: after a mex's first piece, those only go into gaps)
		// Always on a site that links (to the mex, or to the gap end and, when one piece closes it, the other end too),
		// and a step into a gap gets closer to its other end (a gap across water or a cliff is skipped, not clumped at);
		// never beside a mex with an energy job (or a grid link solar or wind) queued there. A spot with no site is
		// skipped for 30 s. None of these: at the nearest metal spot as before (never a base_only piece on land).
		// Missing unit = off
		"fill": {
			"unit": ["energysolar", "energywind"],
			"max_dist": 1500
		},

		// Built on land only within radius elmos of the base position, at most the base defence radius (0.3 of the map
		// diagonal clamped to behaviour.json defence.base_rad, so 1000 on small maps; <= 0: that radius). A rule on the site, at every placement of these defs: energy jobs, the mex chain's energy,
		// fills and grid link pieces (not on where the builder stands: which energy is built doesn't change).
		// On land they go only beside a mex on no grid with energy or into a gap of the grid plan (fill steps 1 and 2),
		// never by the fallbacks that build at a mex or where the builder stands.
		// Where the game builds wind as tidal (ground at or below -10) anywhere, as any energy
		"base_only": {
			"unit": ["energywind"],
			"radius": 1500
		},

		"link_inc": 16.0,  // minimum metal-income for energy linking
		"pylon": ["energypylon", "energysolar", "energywind"]
	},

	// Scales metal income
	// ecoFactor = teamSize*eps_step+(1-eps_step)
	"eps_step": 0.2,

	// Mobile buildpower to metal income ratio
	"buildpower": 1.25,

	// Also build constructors while their metal value is below <ratio> of the mobile army's metal value.
	// Off before <since> seconds of game time; ratio 0 disables. Commanders don't count as constructors.
	"buildpower_army": {"ratio": 0.10, "since": 600},

	// Also build constructors while their metal value is below <ratio> of the metal left in
	// reclaimable features we can see (wrecks, rocks) that the factory's constructor can reach with
	// no enemy threat on them. Off before <since> seconds; ratio 0 disables.
	"buildpower_reclaim": {"ratio": 0.10, "since": 300},

	// Constructor reclaim jobs.
	// value_exp: features rank by distance / (metal left)^value_exp, lower first; 0 = nearest only, 1 = metal per distance.
	// helper_sec: a job takes another constructor while its metal is above <helper_sec> seconds of the build power on it.
	// untaken_sec: a wreck job nobody has taken expires after this many seconds, so stale far jobs don't hold the
	//   untaken-job cap (max(1, constructors / 2)). A job with constructors on it never times out.
	// store_at: while any constructor reclaims and metal is above this share of storage, queue a storage at HIGH; 0 disables.
	// New reclaim jobs stop above 80% metal storage; running ones carry on.
	// travel: how far a constructor looks for new reclaim, in seconds of travel at its speed, by the feature's metal left.
	//   Linear from <sec>[0] at 1 metal to <sec>[1] at <metal> and above, never below <floor>.
	//   <starved_sec> replaces <sec> while metal pull x 0.8 is above income. An idle constructor with no other job
	//   still searches the whole map.
	"reclaim": {"value_exp": 0.5, "helper_sec": 20.0, "untaken_sec": 30, "store_at": 0.7,
	            "travel": {"metal": 2000, "sec": [1, 30], "starved_sec": [1, 60], "floor": 5}},

	// Seconds before a non-combat constructor may build a mex at an undefended cluster without an escort,
	// by map size: [[<map size>, <seconds>], ...], linear between points and clamped at the ends.
	// Map size is sqrt(width * height) in map units, so 8x8 = 8 and 16x16 = 16.
	// Unused while behaviour.json guard.summon is on: constructors never wait for a guard then
	"mex_escort": [[8, 300], [16, 0]],

	// Multiplier on the open mex job cap, (build power / mex cost * 8 + 2) * <mex_jobs>
	"mex_jobs": 1.5,

	// Mex cluster choice leans towards the front (the lane point between our base and the enemy).
	// The <clusters> nearest safe clusters with open spots are scored by
	//   distance to their nearest open spot x (1 - <bias> x progress) x (1 - <started> if we already have a mex queued or built there),
	// progress = how far the cluster centre is along base -> lane (0 at base, 1 at the lane, clamped to [-1, 1]).
	// The lowest-scored cluster wins and its nearest open spot is built. <started> keeps clusters finishing one at a time.
	// bias 0 and clusters 1 = old behaviour (nearest spot in the nearest cluster with an open spot).
	// comm_bias: the bias when a commander's search queues the job (missing = bias). Any constructor can still take the job.
	"mex_front": {"bias": 0.15, "comm_bias": 0.34, "clusters": 3, "started": 0.3},

	// How constructors choose between open jobs: travel cost / <weight> of the job's priority, lowest wins (NOW always wins).
	// travel: seconds of travel per priority; a job beyond its cap is taken only when no job is within its cap. 0 = no cap.
	// A constructor walking to a job switches by direction, the walk measured on its cost map. Forward (a job no nearer
	// our base than it is now, give or take its build range): a job of the same kind nearer than <switch_forward> x the
	// walk left, or of another kind that rates (travel / weight) under <switch_other> x the current one. Back toward
	// our base: the same kind nearer than <switch> x the walk left, never within <commit_sec> seconds of arrival; another
	// kind only if it is NOW or a stall fix. Danger (a flee, a fight at home, a cornered builder's defence) always wins,
	// and so does any job when the current one is cut off. A share of 0 disables that switch. Only a builder between
	// jobs searches for reclaim.
	// In the opening (below), with mex_board on, a walking constructor runs no pick: it leaves its job only for danger,
	// a NOW job or a stall fix other than a mex it could take, or when its spot fails the board's test for 3 s.
	// opening: in the opening, a HIGH mex job weighs <mex_weight> instead of weight.high (an energy stall still ranks it
	//   as normal), reclaim of less than <reclaim_metal> metal ranks as normal, and a constructor with nothing to do
	//   patrols <patrol_sec> seconds (else 20) before it looks again. mex_weight = weight.high, reclaim_metal 0 and
	//   patrol_sec 20 = as after the opening.
	// chain: a builder whose job ends takes its next one in the same frame (not on the idle pass, 20 frames later and
	// one unit at a time), picked from a cost map started where it built; a build starts the frame after its builder
	// arrives
	"builder_jobs": {
		"weight": {"low": 1, "normal": 2, "high": 4},
		"travel": {"low": 10, "normal": 20, "high": 30},
		"switch": 0.5, "switch_forward": 0.8, "switch_other": 0.5, "commit_sec": 4,
		"opening": {"mex_weight": 6, "reclaim_metal": 100, "patrol_sec": 2},
		"chain": true
	},

	// Mex board, in the opening (false = off): builders are matched to mex spots by when each would get there, instead of
	// mex jobs being made one at a time near whichever builder picks. Each builder holds one spot, the one it walks to, or
	// while it builds something else its next. Its arrival is the time left on its job (and on the energy the mex chain
	// queues after a mex) plus the walk from that job's site, scored as mex_front scores clusters (comm_bias for the
	// commander, which never takes a spot another builder reaches sooner); lowest first. As in the mex search, only spots
	// in the mex_front "clusters" nearest clusters count. One walking to its spot keeps it until the spot has failed its
	// test for 3 s (the builder's own danger rule, and threat there within its own strength, so a raider passing doesn't
	// turn a commander that would win), and one fleeing keeps it for <hold_sec>. A next spot nobody walks to yet can move
	// to another builder on any match. A job is made only for a matched builder, and no other builder takes it. Only spots
	// with no threat that the builder would take itself (reach, flee zones, threat, a hiding commander's range), and in
	// team games not nearer an ally's base or factory than ours. A spot whose job failed (unreachable, the build failed)
	// waits 30 s for that builder. Matching runs once a second, and at once when a builder needs a spot. The opening log
	// counts the walks the board ended ("board"), and their next spots as forward or back.
	"mex_board": {"hold_sec": 20},

	// The opening, which some rules read (buildpower_spots, behaviour.json guard.summon.opening_share and
	// choke.radar.opening_share): until "time" seconds (or a [[<map size>, <seconds>], ...] curve, as mex_escort), or 20 s
	// after no open mex spot is left that a builder could take (in team games, not an ally's); time 0 = no opening. log:
	// OPENING lines in infolog once a minute until "time", per builder (seconds idle, walking, building and fleeing, job
	// switches away from our base and back toward it, walks the mex board ended, mexes, jumps, escorts and their wait) and
	// for the team. While the mex board holds a spot the opening goes on
	"opening": {"time": 300, "log": true},

	// In the opening, a factory makes a constructor next (a queued one first, the opener's too) while the open mex spots
	// on safe ground (behaviour.json guard.summon; in team games not an ally's, as mex_board) outnumber <per_builder> x
	// our builders, the commander one of them, up to <max> builders; not before our first combat unit is finished, nor
	// while the known enemy army per enemy team (no commanders or constructors, faded as ms_pull_army) is over 1.5x ours,
	// nor after two constructors died within a minute. per_builder 0 = off
	"buildpower_spots": {"per_builder": 4, "max": 4},

	// Restore terraformed ground (enemy trenches and walls) to the map's start height, as constructor jobs at
	// <priority> ("low", "normal" or "high"; it also sets ZK's build priority, so "high" takes metal before factories).
	// Every 2 s, on 128-elmo cells: a cell is "dug" when at least <share> of its samples (one per 16 elmos) are
	// <depth> elmos or more off the height the map had when the AI started. A dug cell gets a job when a constructor
	// is within <range> and the cell is safe: no known enemy on it or the cells next to it (ZK makes terraform 20x
	// slower near enemies), and no threat on it unless our army covers it: our armed units and static defences
	// within <cover_radius> have at least <cover> x the threat's power (0 = any threat blocks). Only a constructor
	// within <range> for which the cell is safe takes it, <builders> at most per job, <jobs> jobs at once (nearest
	// first). A job is dropped when its cell stops being safe (a known enemy stays near it for <grace> s, or threat
	// our army doesn't cover), a builder's threat-aware path there crosses uncovered threat, or a builder on it is
	// hit, and its builders stop. Once its terraform is made, a job keeps going with half the cover.
	// <grace> rounds up to whole 2 s updates (2 = an enemy seen on two updates in a row).
	// After any drop of a job a builder took (also a builder hit or killed) the cell waits <cooldown> s, doubling on
	// each drop up to 8x until a job finishes. After a finished job the cell waits <cooldown> s, and after <tries>
	// finished jobs that left it dug it is given up until it is back at the start height. Cells with an allied
	// building are skipped (levelled pads); an ally's terraform gives its cell up the same way. range 0 disables.
	// log: every <log> s while any cell is dug, an infolog line "RESTORE: ..." counts why dug cells have no job (the
	// first rule that stopped each) and how jobs ended since the last line ("other": a builder killed or switched to
	// a nearer job, or the cell unreachable). 0 = off.
	"restore": {"range": 1000, "depth": 24, "share": 0.12, "jobs": 2, "builders": 2, "tries": 3, "cooldown": 30, "priority": "high",
		"cover": 2, "cover_radius": 500, "grace": 2, "log": 30},

	// Metal excess to income ratio, -1 to disable
	"excess": -1.0,

	// Mobile constructor to static constructor (factory) metal pull ratio, read while metal stalls (the constructors'
	// stall latch): a factory waits 3 s while factories, it included, x ms_pull pull more than the constructors
	// (unless no constructor spends at all). Pulls are build power on jobs (mex and pylon jobs left out while
	// mex_max >= 1). Higher = factories give way sooner. Constructors hold all new spending in a stall regardless.
	// [[<value>, <start_mex_percent>], [<value>, <end_mex_percent>]]: mex percent = our mexes (queued jobs included)
	// / all metal spots on the map, linear between points and flat beyond the ends
	"ms_pull": [[2.0, 0.0], [0.45, 0.20], [0.99, 0.90]],

	// Multipliers on ms_pull (lower ms_pull = more metal to factories): [[<x>, <multiplier>], ...], linear between
	// points and clamped at the ends; [] = off. A missing key uses the defaults shown.
	// ms_pull_income: x = metal income without reclaim (mex + overdrive + constructor share), from the start
	"ms_pull_income": [[30, 1.0], [160, 0.7]],
	// ms_pull_army: x = metal value of the known enemy mobile army per enemy team / our army's metal value (no
	// constructors or commanders on either side), from <since> seconds of game time and while any enemy army is known
	// (else 1). Enemies out of radar and LOS fade as behaviour.json quota.enemy_half_life says
	"ms_pull_army": {
		"since": 300,
		"curve": [[0.5, 1.3], [2.0, 0.7]]
	},

	// Public chat lines for testing: the ms_pull line below and the threat floor's "Defending" / "Attacking"
	// (behaviour.json quota.attack_threat_floor). The resign line "I am defeated." is always posted
	"chat": false,

	// Public chat line "ms_pull: <value> = base <b> (mex <our mexes / all spots>%) x income <i> (<metal income> m/s) x army <a>
	// (enemy <metal per enemy team> / ours <metal> metal = <ratio>)" when ms_pull has moved by this share
	// since the last line (0.25 = 25%), at most every 20 s; 0 = off; only with "chat": true
	"ms_pull_chat": 0.25,

	// Max percent of mexes circuit team allowed to take.
	// If its <1.0 then expansion obeys ms_pull rule, if >=1.0 then ms_pull doesn't affect expansion (mex, pylon, energy).
	// [<cap_percent>, <is_ally_cap>]
	"mex_max": [2.0, false],  // 200%

	// Construction order delay in seconds, -1 to disable
	// [[<start_delay>, <start_time>], [<end_delay>, <end_time>]]
	"build_delay": [[-1.0, 0], [-1.0, 0]],

	// New factory switch interval, in seconds (each new factory resets timer, switch event is also based on eco + caretakers)
	// switch = random(<min_interval>..<max_interval>)
	"switch": [800, 900],

	"terra": "terraunit",
	"airpad": "staticrearm",

	// Unknown UnitDef replacer
	"default": "turretmissile"
}
}
